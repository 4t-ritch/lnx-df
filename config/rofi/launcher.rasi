* {
  bg: rgba(26, 27, 28, 98%);
  bg-panel: rgba(39, 39, 40, 96%);
  bg-panel-strong: rgba(52, 52, 53, 98%);
  bg-hover: rgba(201, 201, 203, 13%);
  bg-active: rgba(201, 201, 203, 13%);
  fg: #dedee0;
  fg-muted: #c1c1c3;
  fg-subtle: #a9aaad;
  fg-strong: #dedee0;
  border: rgba(201, 201, 203, 70%);
  border-soft: rgba(201, 201, 203, 25%);

  font: "Noto Sans 11";
}

window {
  transparency: "real";
  location: center;
  anchor: center;
  width: 42%;
  border: 1px;
  border-color: @border;
  border-radius: 0;
  background-color: @bg;
}

mainbox {
  spacing: 10px;
  padding: 16px;
  background-color: transparent;
  children: [ inputbar, listview ];
}

inputbar {
  expand: false;
  orientation: horizontal;
  spacing: 10px;
  padding: 0;
  background-color: transparent;
  children: [ prompt, entry ];
}

prompt {
  expand: false;
  padding: 0 0 0 2px;
  background-color: transparent;
  text-color: @fg-muted;
}

entry {
  expand: true;
  padding: 12px 14px;
  placeholder: "Search applications";
  placeholder-color: @fg-subtle;
  background-color: @bg-panel;
  text-color: @fg;
  border: 1px;
  border-color: @border-soft;
  border-radius: 0;
}

mode-switcher {
  expand: false;
  spacing: 6px;
  padding: 0 2px;
  background-color: transparent;
}

button {
  padding: 8px 12px;
  background-color: @bg-panel;
  text-color: @fg-subtle;
  border: 1px;
  border-color: @border-soft;
  border-radius: 0;
}

button selected {
  background-color: @bg-active;
  text-color: @fg-strong;
  border-color: @border;
}

listview {
  columns: 1;
  lines: 10;
  cycle: true;
  dynamic: true;
  scrollbar: false;
  fixed-height: false;
  spacing: 2px;
  background-color: transparent;
}

element {
  orientation: horizontal;
  spacing: 12px;
  padding: 12px 14px;
  background-color: transparent;
  text-color: @fg;
  border: 1px;
  border-color: transparent;
  border-radius: 0;
}

element selected.normal,
element selected.active,
element selected.urgent {
  background-color: @bg-panel-strong;
  text-color: @fg-strong;
  border-color: @border;
}

element-icon {
  size: 22px;
  background-color: transparent;
}

element-text {
  expand: true;
  background-color: transparent;
  text-color: inherit;
  vertical-align: 0.5;
}

message {
  padding: 12px;
  background-color: @bg-panel;
  border: 1px;
  border-color: @border-soft;
  border-radius: 0;
}

textbox {
  text-color: @fg;
  background-color: transparent;
}

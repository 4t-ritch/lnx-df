#!/usr/bin/env bash
# vis-tree: floating file tree for vis, rendered with fzf.
#
# The UI is a self-contained loop: fzf exits on every action key, the action
# runs with a free terminal, then the tree is re-rendered. Expansion and
# collapse stay inside fzf through transform bindings, so navigation does not
# flicker.
#
# Output: the absolute path of the selected file on stdout (exit 0).
#         nothing on abort (exit 1).

set -uo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/vis"
STATE="${VIS_TREE_STATE:-$CACHE/tree.state}"
CLIP="$CACHE/tree.clip"
ROOT="${VIS_TREE_ROOT:-$PWD}"

COLORS='fg:#BBBBBB,bg:#191919,hl:#B279A7,fg+:#BBBBBB,bg+:#444444,hl+:#B279A7,info:#6099C0,prompt:#9E9E9E,pointer:#DE6E7C,marker:#819B69,spinner:#66A5AD,header:#939393,label:#9E9E9E,query:#BBBBBB,border:#797979,disabled:#555555'

declare -A EXPANDED=()
declare -A HIDDEN=()
SHOW_DOT=0

load_state() {
	EXPANDED=()
	HIDDEN=()
	SHOW_DOT=0
	[[ -f $STATE ]] || return 0
	while IFS=$'\t' read -r key val; do
		case $key in
			E) EXPANDED["$val"]=1 ;;
			H) HIDDEN["$val"]=1 ;;
			D) SHOW_DOT=1 ;;
		esac
	done <"$STATE"
}

save_state() {
	mkdir -p "$CACHE"
	{
		for p in "${!EXPANDED[@]}"; do printf 'E\t%s\n' "$p"; done
		for p in "${!HIDDEN[@]}"; do printf 'H\t%s\n' "$p"; done
		((SHOW_DOT)) && printf 'D\t1\n'
	} | sort >"$STATE.tmp"
	mv "$STATE.tmp" "$STATE"
}

expand_to() {
	local p="$1" d
	d="$(dirname "$p")"
	while [[ $d == "$ROOT"/* ]]; do
		EXPANDED["$d"]=1
		d="$(dirname "$d")"
	done
	EXPANDED["$ROOT"]=1
}

# ---------- rendering ----------

render_dir() {
	local dir="$1" depth="$2" pad name kind path
	((depth > 12)) && return
	pad="$(printf '%*s' $((depth * 2)) '')"
	while IFS=$'\t' read -r kind name; do
		[[ -z $name ]] && continue
		[[ $name == .* && $SHOW_DOT -eq 0 ]] && continue
		path="$dir/$name"
		[[ -n ${HIDDEN[$path]:-} ]] && continue
		if [[ $kind == d ]]; then
			if [[ -n ${EXPANDED[$path]:-} ]]; then
				printf '%s▾ %s/\t%s\tdir\n' "$pad" "$name" "$path"
				render_dir "$path" $((depth + 1))
			else
				printf '%s▸ %s/\t%s\tdir\n' "$pad" "$name" "$path"
			fi
		else
			printf '%s  %s\t%s\tfile\n' "$pad" "$name" "$path"
		fi
	done < <(find "$dir" -mindepth 1 -maxdepth 1 -printf '%y\t%f\n' 2>/dev/null |
		sort -f -t$'\t' -k1,1 -k2,2)
}

render() {
	load_state
	printf '▾ %s/\t%s\tdir\n' "$(basename "$ROOT")" "$ROOT"
	[[ $ROOT != / ]] && printf '⬆ ../\t%s\tparent\n' "$(dirname "$ROOT")"
	render_dir "$ROOT" 1
}

# ---------- prompts ----------

ask() { # prompt, default
	local prompt="$1" default="${2-}" res
	res=$(fzf --height=3 --min-height=3 --layout=reverse --border=rounded \
		--info=hidden --pointer='▌' --prompt="$prompt " --print-query \
		--phony --query="$default" --color="$COLORS" </dev/null 2>/dev/null | head -n1)
	printf '%s' "$res"
}

confirm() { # question
	local ans
	ans=$(printf 'No\nYes\n' | fzf --height=3 --min-height=3 --layout=reverse \
		--border=rounded --info=hidden --pointer='▌' --prompt="$1 " \
		--color="$COLORS" 2>/dev/null)
	[[ $ans == Yes ]]
}

# ---------- actions ----------

new_entry() { # target_dir, file|dir
	local dir="$1" kind="$2" name path label='New file: '
	[[ $kind == dir ]] && label='New dir: '
	name="$(ask "$label" '')"
	[[ -z $name ]] && return 1
	if [[ $name == /* ]]; then path="$name"; else path="$dir/$name"; fi
	if [[ $kind == dir || $name == */ ]]; then
		mkdir -p "${path%/}" || return 1
		load_state
		expand_to "${path%/}"
	else
		mkdir -p "$(dirname "$path")" || return 1
		touch "$path" || return 1
		load_state
		expand_to "$path"
	fi
	save_state
}

do_copy() { # path
	printf '%s\n' "$1" >"$CLIP"
}

do_paste() { # target_dir
	local src dest base name ext n=1
	[[ -f $CLIP ]] || return 1
	src="$(head -n1 "$CLIP")"
	[[ -n $src && -e $src ]] || return 1
	base="$(basename "$src")"
	dest="$1/$base"
	[[ $src == "$dest" ]] && return 1
	if [[ -e $dest ]]; then
		name="${base%.*}"
		ext=""
		[[ $name != "$base" ]] && ext=".${base##*.}"
		dest="$1/${name} copy${ext}"
		while [[ -e $dest ]]; do
			dest="$1/${name} copy ${n}${ext}"
			n=$((n + 1))
		done
	fi
	cp -r -- "$src" "$dest"
}

do_duplicate() { # path, target_dir
	local src="$1" dir="$2" base name ext dest n=1
	base="$(basename "$src")"
	name="${base%.*}"
	ext=""
	[[ $name != "$base" ]] && ext=".${base##*.}"
	dest="$dir/${name} copy${ext}"
	while [[ -e $dest ]]; do
		dest="$dir/${name} copy ${n}${ext}"
		n=$((n + 1))
	done
	cp -r -- "$src" "$dest"
}

do_rename() { # path
	local path="$1" base new dest
	[[ $path == "$ROOT" ]] && return 1
	base="$(basename "$path")"
	new="$(ask 'Rename to:' "$base")"
	[[ -z $new || $new == "$base" ]] && return 1
	dest="$(dirname "$path")/$new"
	mv -- "$path" "$dest"
}

do_delete() { # path
	local path="$1"
	[[ $path == "$ROOT" ]] && return 1
	confirm "Delete $(basename "$path")?" || return 1
	rm -rf -- "$path"
}

do_hide() { # path
	local path="$1"
	[[ $path == "$ROOT" ]] && return 1
	load_state
	HIDDEN["$path"]=1
	save_state
}

do_unhide() {
	local sel
	load_state
	[[ ${#HIDDEN[@]} -eq 0 ]] && return 1
	sel=$(for p in "${!HIDDEN[@]}"; do printf '%s\n' "$p"; done |
		sort | fzf --multi --height=60% --min-height=8 --layout=reverse \
			--border=rounded --border-label=' Hidden entries ' \
			--info=hidden --pointer='▌' --prompt='unhide > ' \
			--color="$COLORS" 2>/dev/null)
	[[ -z $sel ]] && return 1
	while IFS= read -r p; do
		[[ -n $p ]] && unset 'HIDDEN[$p]'
	done <<<"$sel"
	save_state
}

do_toggle_dots() {
	load_state
	SHOW_DOT=$((1 - SHOW_DOT))
	save_state
}

# ---------- fzf plumbing ----------

on_right() { # path, kind
	[[ $2 == dir ]] || return 0
	printf 'execute-silent(%q toggle %q)+reload-sync(%q render)' "$SELF" "$1" "$SELF"
}

on_left() { # path, kind
	[[ $2 == dir ]] || return 0
	printf 'execute-silent(%q collapse %q)+reload-sync(%q render)' "$SELF" "$1" "$SELF"
}

pick() {
	local list pos=1 i=0 p
	list="$(render)"
	if [[ -n ${VIS_TREE_FOCUS:-} ]]; then
		while IFS=$'\t' read -r _ p _; do
			i=$((i + 1))
			if [[ $p == "$VIS_TREE_FOCUS" ]]; then pos=$i; break; fi
		done <<<"$list"
	fi
	FZF_DEFAULT_OPTS= fzf --height=85% --min-height=12 --layout=reverse \
		--border=rounded --border-label=' File Tree ' --info=inline-right \
		--pointer='▌' --delimiter=$'\t' --with-nth=1 --nth=1 --no-sort \
		--track --id-nth=2 --prompt="$(basename "$ROOT") > " \
		--header=' Enter: open/toggle · C-a: new file · C-d: new dir · C-r: rename · C-x: delete ' \
		--footer=' C-c: copy · C-p: paste · C-y: duplicate · C-h: hide · C-u: unhide · C-o: dotfiles ' \
		--expect=ctrl-a,ctrl-d,ctrl-c,ctrl-p,ctrl-y,ctrl-r,ctrl-x,ctrl-h,ctrl-u,ctrl-o,ctrl-g \
		--bind="right:transform:$SELF on-right {2} {3}" \
		--bind="left:transform:$SELF on-left {2} {3}" \
		--bind="load:pos($pos)" \
		--color="$COLORS" <<<"$list"
}

ui() {
	ROOT="$(realpath -e "${1:-$PWD}" 2>/dev/null || printf '%s' "${1:-$PWD}")"
	export VIS_TREE_ROOT="$ROOT"
	mkdir -p "$CACHE"
	while :; do
		local out status key line kind path target
		out="$("$SELF" pick)"
		status=$?
		[[ $status -ne 0 ]] && return 1

		key="$(printf '%s\n' "$out" | sed -n '1p')"
		line="$(printf '%s\n' "$out" | sed -n '2p')"
		[[ -z $line ]] && continue

		kind="$(printf '%s' "$line" | cut -f3)"
		path="$(printf '%s' "$line" | cut -f2)"
		export VIS_TREE_FOCUS="$path"

		if [[ $kind == dir ]]; then
			target="$path"
		else
			target="$(dirname "$path")"
		fi

		case $key in
			ctrl-a) new_entry "$target" file ;;
			ctrl-d) new_entry "$target" dir ;;
			ctrl-c) do_copy "$path" ;;
			ctrl-p) do_paste "$target" ;;
			ctrl-y) do_duplicate "$path" "$target" ;;
			ctrl-r) do_rename "$path" ;;
			ctrl-x) do_delete "$path" ;;
			ctrl-h) do_hide "$path" ;;
			ctrl-u) do_unhide ;;
			ctrl-o) do_toggle_dots ;;
			ctrl-g) : ;;
			*)
				case $kind in
					parent) ROOT="$(dirname "$ROOT")"; export VIS_TREE_ROOT="$ROOT" ;;
					dir) "$SELF" toggle "$path" ;;
					file) printf '%s\n' "$path"; return 0 ;;
				esac
				;;
		esac
	done
}

# ---------- subcommands ----------

case "${1:-}" in
	toggle) shift; load_state; p="$1";
		if [[ -n ${EXPANDED[$p]:-} ]]; then unset 'EXPANDED[$p]'; else EXPANDED["$p"]=1; fi
		save_state ;;
	collapse) shift; load_state; p="$1";
		unset 'EXPANDED[$p]'; save_state ;;
	render) render ;;
	on-right) shift; on_right "$@" ;;
	on-left) shift; on_left "$@" ;;
	pick) pick ;;
	ui) shift; ui "${1:-$PWD}" ;;
	*) printf 'usage: %s {ui [dir]|render|toggle|collapse|pick|on-right|on-left}\n' "$SELF" >&2; exit 2 ;;
esac

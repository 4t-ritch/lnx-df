[
  {
    "layer": "top",
    "position": "top",
    "height": 30,
    "exclusive": true,
    "expand-left": true,
    "spacing": 8,
    "output": [
      "DP-2"
    ],
    "modules-left": [
      "hyprland/workspaces",
      "hyprland/window"
    ],
    "modules-center": [],
    "modules-right": [
      "tray",
      "custom/keyboard",
      "clock"
    ],
    "hyprland/window": {
      "format": "<span text_transform='lowercase'>{class}</span>",
      "rewrite": {
        "^<span text_transform='lowercase'>brave-aalgkepfhigihlhelhgejbkkmmbgbpmb-Profile_3</span>$": "<span text_transform='lowercase'>Webex</span>",
        "^<span text_transform='lowercase'>brave-chatgpt\\.com__-Default</span>$": "<span text_transform='lowercase'>ChatGPT</span>",
        "^<span text_transform='lowercase'>lnx-df-webapp-chatgpt</span>$": "<span text_transform='lowercase'>ChatGPT</span>",
        "^<span text_transform='lowercase'>brave-hnpfjngllnobngcgfapefoaidbinmjnm-Default</span>$": "<span text_transform='lowercase'>WhatsApp</span>",
        "^<span text_transform='lowercase'>brave-web\\.whatsapp\\.com__-Default</span>$": "<span text_transform='lowercase'>WhatsApp</span>",
        "^<span text_transform='lowercase'>lnx-df-webapp-whatsapp</span>$": "<span text_transform='lowercase'>WhatsApp</span>",
        "^<span text_transform='lowercase'>org\\.gnome\\.Nautilus</span>$": "<span text_transform='lowercase'>Nautilus</span>"
      },
      "align": 0.0,
      "justify": "left",
      "expand": true,
      "separate-outputs": true
    },
    "hyprland/workspaces": {
      "sort-by": "id",
      "all-outputs": false,
      "format": "{name}",
      "on-scroll-up": "~/.config/hypr/scripts/ws-cycle.sh prev",
      "on-scroll-down": "~/.config/hypr/scripts/ws-cycle.sh next"
    },
    "tray": {
      "icon-size": 18,
      "show-passive-items": true,
      "spacing": 10
    },
    "custom/notification": {
      "tooltip": false,
      "format": "{icon}",
      "format-icons": {
        "notification": "󰂚",
        "none": "󰂜",
        "dnd-notification": "󰂛",
        "dnd-none": "󰂛"
      },
      "return-type": "json",
      "exec-if": "which swaync-client",
      "exec": "swaync-client -swb",
      "on-click": "swaync-client -t -sw",
      "on-click-right": "swaync-client -d -sw",
      "escape": true
    },
    "custom/keyboard": {
      "exec": "~/.config/waybar/scripts/keyboard-layout.sh --status",
      "return-type": "json",
      "interval": 2,
      "on-click": "~/.config/waybar/scripts/keyboard-layout.sh --menu",
      "on-click-right": "~/.config/waybar/scripts/keyboard-layout.sh --cycle",
      "on-click-middle": "~/.config/waybar/scripts/keyboard-layout.sh --ime-toggle",
      "tooltip": true
    },
    "clock": {
      "format": "{:%a %d  %H:%M}",
      "tooltip": false
    }
  },
  {
    "layer": "top",
    "position": "top",
    "height": 30,
    "exclusive": true,
    "expand-left": true,
    "spacing": 8,
    "output": [
      "HDMI-A-1"
    ],
    "modules-left": [
      "hyprland/workspaces",
      "hyprland/window"
    ],
    "modules-center": [],
    "modules-right": [
      "custom/keyboard",
      "clock"
    ],
    "hyprland/window": {
      "format": "<span text_transform='lowercase'>{class}</span>",
      "rewrite": {
        "^<span text_transform='lowercase'>brave-aalgkepfhigihlhelhgejbkkmmbgbpmb-Profile_3</span>$": "<span text_transform='lowercase'>Webex</span>",
        "^<span text_transform='lowercase'>brave-chatgpt\\.com__-Default</span>$": "<span text_transform='lowercase'>ChatGPT</span>",
        "^<span text_transform='lowercase'>lnx-df-webapp-chatgpt</span>$": "<span text_transform='lowercase'>ChatGPT</span>",
        "^<span text_transform='lowercase'>brave-hnpfjngllnobngcgfapefoaidbinmjnm-Default</span>$": "<span text_transform='lowercase'>WhatsApp</span>",
        "^<span text_transform='lowercase'>brave-web\\.whatsapp\\.com__-Default</span>$": "<span text_transform='lowercase'>WhatsApp</span>",
        "^<span text_transform='lowercase'>lnx-df-webapp-whatsapp</span>$": "<span text_transform='lowercase'>WhatsApp</span>",
        "^<span text_transform='lowercase'>org\\.gnome\\.Nautilus</span>$": "<span text_transform='lowercase'>Nautilus</span>"
      },
      "align": 0.0,
      "justify": "left",
      "expand": true,
      "separate-outputs": true
    },
    "hyprland/workspaces": {
      "sort-by": "id",
      "all-outputs": false,
      "format": "{name}",
      "on-scroll-up": "~/.config/hypr/scripts/ws-cycle.sh prev",
      "on-scroll-down": "~/.config/hypr/scripts/ws-cycle.sh next"
    },
    "custom/keyboard": {
      "exec": "~/.config/waybar/scripts/keyboard-layout.sh --status",
      "return-type": "json",
      "interval": 2,
      "on-click": "~/.config/waybar/scripts/keyboard-layout.sh --menu",
      "on-click-right": "~/.config/waybar/scripts/keyboard-layout.sh --cycle",
      "on-click-middle": "~/.config/waybar/scripts/keyboard-layout.sh --ime-toggle",
      "tooltip": true
    },
    "clock": {
      "format": "{:%a %d  %H:%M}",
      "tooltip": false
    }
  }
]
